OAW_POSTGRES_PASSWORD=openassetwatch_local_only_change_me
OPENASSETWATCH_COLLECTOR_TOKEN=
OPENASSETWATCH_ADMIN_TOKEN=
# The collector token is local-development compatibility for passive sensors.
# Configure the admin token before creating, rotating, or revoking sensor credentials.
OPENASSETWATCH_AI_PROVIDER=demo
OPENASSETWATCH_AI_EXTERNAL_ENABLED=false
OPENASSETWATCH_AI_BASE_URL=
OPENASSETWATCH_AI_MODEL=
OPENASSETWATCH_AI_TIMEOUT_SECONDS=10
OPENASSETWATCH_AI_LOCAL_PROVIDER_HOSTS=
OPENASSETWATCH_AI_QUALIFICATION_RESULT=
# Optional bounded deterministic findings/risk overrides. Omitted values use
# the reviewed defaults documented in docs/DETERMINISTIC_FINDINGS_AND_RISK.md.
# OPENASSETWATCH_FINDINGS_SENSOR_STALE_MINUTES=120
# OPENASSETWATCH_FINDINGS_ASSET_STALE_HOURS=72
# OPENASSETWATCH_FINDINGS_NEW_ASSET_HOURS=24
# OPENASSETWATCH_FINDINGS_EVIDENCE_FRESH_HOURS=24
# OPENASSETWATCH_FINDINGS_EVIDENCE_AGING_HOURS=72
# OPENASSETWATCH_FINDINGS_MAX_CANDIDATES=10000
# OPENASSETWATCH_RISK_WEIGHT_CRITICAL=40
# OPENASSETWATCH_RISK_CAP_IDENTITY=35
# Set OPENASSETWATCH_AI_API_KEY only in an untracked runtime environment when a hosted provider is enabled.
# Approved local OpenAI-compatible example for an ignored .env file:
# OPENASSETWATCH_AI_PROVIDER=openai-compatible
# OPENASSETWATCH_AI_EXTERNAL_ENABLED=false
# OPENASSETWATCH_AI_BASE_URL=http://host.docker.internal:11434/v1
# OPENASSETWATCH_AI_MODEL=your-local-model
# Keep blank for built-in local names. For a Compose service, list exact names only, for example: rocmfpx
# OPENASSETWATCH_AI_LOCAL_PROVIDER_HOSTS=
# Optional operator-owned qualification JSON; a configured invalid or rejected result disables the local provider.
# OPENASSETWATCH_AI_QUALIFICATION_RESULT=
# Omit OPENASSETWATCH_AI_API_KEY for a local endpoint that does not require one.
OPENASSETWATCH_CONTROL_TOWER_VERSION=0.1.0
OPENASSETWATCH_EXPECTED_AGENT_VERSION=0.1.0
OPENASSETWATCH_AGENT_RELEASE_CHANNEL=local
OPENASSETWATCH_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
