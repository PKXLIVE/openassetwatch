{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oaw:dashboard-composition:v1:integrity",
  "title": "Exact-byte draft package integrity index",
  "$comment": "Draft Milestone C contract. Shape validation does not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "version",
    "status",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "oaw.dashboard-package-integrity.v1"
    },
    "package_id": {
      "const": "dashboard-composition"
    },
    "version": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/version"
    },
    "status": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/artifactStatus"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*\\/)*[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "digest": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/digest"
          }
        }
      }
    }
  }
}
