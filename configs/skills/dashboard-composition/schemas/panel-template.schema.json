{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oaw:dashboard-composition:v1:panel-template",
  "title": "Panel template contract",
  "$comment": "Draft Milestone C contract. Shape validation does not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "title",
    "approval_owner",
    "availability",
    "intent",
    "visualization",
    "semantic_requirements",
    "parameters",
    "layout",
    "refresh",
    "resource_limits",
    "drilldowns",
    "provenance",
    "accessibility",
    "quality",
    "executable_content"
  ],
  "properties": {
    "schema": {
      "const": "oaw.panel-template.v1"
    },
    "id": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/id"
    },
    "version": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/version"
    },
    "status": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/artifactStatus"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "approval_owner": {
      "const": "openassetwatch"
    },
    "availability": {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/availability"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "variants"
      ],
      "properties": {
        "family": {
          "enum": [
            "metric_summary",
            "time_series",
            "ranked_bar",
            "composition",
            "column",
            "table",
            "timeline",
            "status_matrix",
            "text",
            "evidence"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/id"
          }
        }
      }
    },
    "semantic_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible_metrics",
        "allowed_dimensions",
        "aggregation",
        "time_context",
        "data_shape"
      ],
      "properties": {
        "compatible_metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/artifactRef"
          }
        },
        "allowed_dimensions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/dimension"
          }
        },
        "aggregation": {
          "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/aggregation"
        },
        "time_context": {
          "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/timeMode"
        },
        "data_shape": {
          "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/dataShape"
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/variableDefinition"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_kinds",
        "collapse_to"
      ],
      "properties": {
        "permitted_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/layoutKind"
          }
        },
        "collapse_to": {
          "const": "one_column"
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "default"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/refreshMode"
          }
        },
        "default": {
          "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/refresh"
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_queries",
        "max_query_seconds",
        "max_rows",
        "max_series",
        "max_categories"
      ],
      "properties": {
        "max_queries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_query_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_series": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_categories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "drilldowns": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "destination",
          "dimension",
          "compatible_metrics"
        ],
        "properties": {
          "id": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/id"
          },
          "destination": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/drilldownTarget"
          },
          "dimension": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/dimension"
          },
          "compatible_metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/artifactRef"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_metric_versions",
        "require_visible_filters",
        "require_source_freshness",
        "unknown_freshness_allowed",
        "require_evidence_refs_when_applicable"
      ],
      "properties": {
        "pin_metric_versions": {
          "const": true
        },
        "require_visible_filters": {
          "const": true
        },
        "require_source_freshness": {
          "const": true
        },
        "unknown_freshness_allowed": {
          "type": "boolean"
        },
        "require_evidence_refs_when_applicable": {
          "const": true
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessible_label",
        "text_value_or_table",
        "keyboard_drilldowns"
      ],
      "properties": {
        "accessible_label": {
          "const": true
        },
        "text_value_or_table": {
          "const": true
        },
        "keyboard_drilldowns": {
          "const": true
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_is_zero",
        "states"
      ],
      "properties": {
        "missing_is_zero": {
          "const": false
        },
        "states": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/panelState"
          }
        }
      }
    },
    "executable_content": {
      "const": false
    }
  },
  "allOf": [
    {
      "$ref": "urn:oaw:dashboard-composition:v1:common#/$defs/availabilityGate"
    }
  ]
}
