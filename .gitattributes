* text=auto
.gitattributes text eol=lf

# GitHub Actions and config should stay LF for CI portability.
*.yml text eol=lf
*.yaml text eol=lf

# Source and docs should stay LF.
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
packaging/sensor/linux/systemd/*.service text eol=lf
packaging/sensor/linux/examples/*.json text eol=lf

# Signed advisory fixtures are verified as exact bytes on every platform.
backend/advisory_feeds/*.json text eol=lf
backend/advisory_feeds/fixtures/**/*.json text eol=lf
backend/advisory_feeds/fixtures/**/*.ed25519 -text
